// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderer snapshots > table > renders a basic two-column table 1`] = `
"name    │ score
────────┼──────
Alice   │   100
Bob     │    42
Charlie │     7"
`;

exports[`renderer snapshots > table > renders a table with format function and multi-line cells 1`] = `
"  # │ title
────┼────────────────────
  1 │ Example
    │ https://example.com
  2 │ GitHub
    │ https://github.com"
`;

exports[`renderer snapshots > table > renders a table with indent 1`] = `
"    item    │ qty
────────────┼────
    Apples  │   5
    Bananas │  12"
`;

exports[`renderer snapshots table renders a basic two-column table 1`] = `
"name    │ score
────────┼──────
Alice   │   100
Bob     │    42
Charlie │     7"
`;

exports[`renderer snapshots table renders a table with format function and multi-line cells 1`] = `
"  # │ title
────┼────────────────────
  1 │ Example
    │ https://example.com
  2 │ GitHub
    │ https://github.com"
`;

exports[`renderer snapshots table renders a table with indent 1`] = `
"    item    │ qty
────────────┼────
    Apples  │   5
    Bananas │  12"
`;
